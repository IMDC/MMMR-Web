# ── Local development configuration ─────────────────────────────────────────
# Copy this file to server/.env and fill in the two values marked REQUIRED.
# server/.env is gitignored and must never be committed — this repo is public.

# ── REQUIRED ────────────────────────────────────────────────────────────────

# Your OpenAI API key, from https://platform.openai.com → API keys.
# Used for Whisper transcription and GPT analysis. Both fail without it.
API_OPENAI_CHATGPT=sk-proj-replace-with-your-real-openai-key

# Signs the login session cookie. Any long random string.
# Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=replace-with-a-long-random-string

# ── Defaults that work as-is locally ────────────────────────────────────────

PORT=5001
# 5000 is reserved by AirPlay Receiver on macOS, hence 5001.

MONGODB_URI=mongodb://localhost:27017/mhmr
# The database and its collections are created on first use.

UPLOADS_DIR=./uploads/videos
# Relative to server/. Created automatically on the first upload.

MAX_FILE_SIZE_MB=500
NODE_ENV=development
CORS_ORIGIN=http://localhost:3000

# Must stay false over plain http://localhost — a secure cookie is dropped
# on an insecure connection, which looks like the login silently failing.
SECURE_COOKIES=false

# ── Analysis model ──────────────────────────────────────────────────────────
# GPT-5 rejects `max_tokens` and any non-default `temperature`.
# 'minimal' reasoning effort keeps output closest to the previous gpt-4o tuning.
OPENAI_MODEL=gpt-5
OPENAI_REASONING_EFFORT=minimal
OPENAI_MAX_COMPLETION_TOKENS=1500

# ── Login rate limiting ─────────────────────────────────────────────────────
# Counted per account AND per IP. Uncomment the last line if repeated login
# testing keeps locking you out of your own dev account.
LOGIN_MAX_PER_ACCOUNT=5
LOGIN_MAX_PER_IP=100
LOGIN_WINDOW_MINUTES=15
#LOGIN_RATELIMIT_DISABLED=true

# ── Legacy ──────────────────────────────────────────────────────────────────
# Unused. The app transcribes with Whisper, not IBM Watson. Kept so older
# .env files do not break; leave it empty.
API_KEY_SPEECH_TO_TEXT=
