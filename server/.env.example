PORT=5001
MONGODB_URI=mongodb://localhost:27017/mhmr
SESSION_SECRET=change-me-to-a-long-random-string
API_OPENAI_CHATGPT=sk-your-openai-key-here
API_KEY_SPEECH_TO_TEXT=your-ibm-watson-key-here
UPLOADS_DIR=./uploads/videos
MAX_FILE_SIZE_MB=500
NODE_ENV=development

# Analysis model. GPT-5 rejects `max_tokens` and any non-default `temperature`.
# 'minimal' reasoning effort keeps output closest to the previous gpt-4o tuning.
OPENAI_MODEL=gpt-5
OPENAI_REASONING_EFFORT=minimal
OPENAI_MAX_COMPLETION_TOKENS=1500
